# ── Neo4j 연결 ─────────────────────────────────────────────────────
# 로컬 도커: neo4j://neo4j:7687  (서비스 이름이 neo4j 이므로)
# Neo4j Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── LLM 공급자 선택 ────────────────────────────────────────────────
# KB 구축(인제스트): ollama | gemini | openai | exaone
LLM_PROVIDER=ollama
# 답변 생성(런타임): ollama | gemini | hf
RUNTIME_LLM=ollama

# ── Ollama 설정 (기본값, 로컬/도커 모두 사용) ──────────────────────
# 로컬 실행 시: http://localhost:11434
# 도커 실행 시: http://ollama:11434  (docker-compose가 자동 주입)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_TIMEOUT=180

# ── Gemini (선택사항 — RUNTIME_LLM=gemini 또는 LLM_PROVIDER=gemini 시) ──
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (선택사항 — LLM_PROVIDER=openai 시) ──────────────────────
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# ── RAG 튜닝 파라미터 ────────────────────────────────────────────────
CHUNK_SIZE=380
CHUNK_OVERLAP=76
SIM_THRESHOLD=0.27
GATE_MIN_TOP_SCORE=0.25
GATE_MIN_EVIDENCE=2

# ── PDF 파일 경로 ───────────────────────────────────────────────────
PDF_DIR=/app/pdf_dir
