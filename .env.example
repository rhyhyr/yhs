# ─────────────────────────────────────────────────────────────────────────────
# 환경 설정 템플릿
#
#   cp .env.example .env    로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지
#   않습니다.
#
# 여기에는 "환경마다 달라지는 값"만 둡니다 — 비밀키, 접속 주소, 실행 모드.
# 가중치·임계값·라우팅 표 같은 튜닝 값은 backend/config/*.yaml 에 있습니다.
# (같은 항목이 양쪽에 있으면 환경변수가 이깁니다. 실험 스윕용입니다.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j 접속 ───────────────────────────────────────────────────────────────
# 로컬 실행:  bolt://localhost:7687
# 도커 실행:  neo4j://neo4j:7687   (compose 가 자동 주입)
# Neo4j Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── LLM 공급자 선택 ──────────────────────────────────────────────────────────
# LLM_PROVIDER : KB 구축(인제스트)용   — ollama | gemini | openai | exaone
# RUNTIME_LLM  : 답변 생성(런타임)용   — ollama | gemini | openai | hf
LLM_PROVIDER=ollama
RUNTIME_LLM=ollama

# ── Ollama ───────────────────────────────────────────────────────────────────
# 로컬: http://localhost:11434 / 도커: http://ollama:11434 (compose 가 자동 주입)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_TIMEOUT=180

# ── OpenAI (RUNTIME_LLM=openai 또는 LLM_PROVIDER=openai 일 때) ───────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_RUNTIME_MODEL=gpt-4o-mini

# ── Gemini (RUNTIME_LLM=gemini 또는 LLM_PROVIDER=gemini 일 때) ───────────────
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── 경로 ─────────────────────────────────────────────────────────────────────
# 비워 두면 저장소 기준 기본값을 씁니다: DATA_DIR=./data, PDF_DIR=./data/sources
# 상대 경로는 저장소 루트 기준으로 해석됩니다 (cwd 와 무관).
# DATA_DIR=data
# PDF_DIR=data/sources

# ── 임베딩 ───────────────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# ─────────────────────────────────────────────────────────────────────────────
# 아래는 backend/config/*.yaml 값을 일시적으로 덮어쓰는 용도입니다.
# 평상시에는 주석 상태로 두고, YAML 을 고치세요.
# 실험 스윕(experiments/)에서만 쓰는 것을 권장합니다.
# ─────────────────────────────────────────────────────────────────────────────
# retrieval.yaml 오버라이드
# TOP_K_VECTOR=5
# TOP_K_GRAPH_DEFAULT=8
# DEFAULT_HOP_DEPTH=2
# GATE_MIN_TOP_SCORE=0.25
# GATE_MIN_EVIDENCE=2
# ENTITY_LINK_COSINE_THRESHOLD=0.72

# crawler.yaml 오버라이드
# VEC_WEIGHT=0.62
# KW_WEIGHT=0.38
# CRAWL_MAX_DEPTH=6
# CRAWL_MAX_PAGES=50

# 기능 토글
# ENABLE_ZH_TRANSLATION=true
