# ── Neo4j 연결 ─────────────────────────────────────────────────────
# 로컬 도커: neo4j://neo4j:7687  (서비스 이름이 neo4j 이므로)
# Neo4j Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── LLM API ────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# ── RAG 튜닝 파라미터 ────────────────────────────────────────────────
CHUNK_SIZE=380
CHUNK_OVERLAP=76
SIM_THRESHOLD=0.27
GATE_MIN_TOP_SCORE=0.25
GATE_MIN_EVIDENCE=2

# ── PDF 파일 경로 ───────────────────────────────────────────────────
PDF_DIR=/app/pdf_dir
