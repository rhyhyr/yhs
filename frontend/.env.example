# UniGuide AI — 프론트엔드 환경변수 템플릿
# 사용법: cp .env.example .env

# 백엔드 API 주소.
# 비워 두면 같은 오리진의 /api 로 호출합니다 (dev: vite 프록시, 운영: nginx).
# 보통은 비워 두는 게 맞습니다.
VITE_API_BASE_URL=

# vite dev 서버가 /api 요청을 넘길 백엔드 주소 (개발 전용)
VITE_DEV_API_TARGET=http://localhost:8000

# true 로 두면 백엔드 없이 mock 데이터로만 동작합니다 (디자인/퍼블리싱 작업용)
VITE_USE_MOCK=false

# 앱 이름 (선택)
VITE_APP_NAME=UniGuide AI
