# YuGuide AI — 프론트엔드 환경변수 템플릿
# 사용법: cp .env.example .env

# 백엔드 API 주소.
# 비워 두면 같은 오리진의 /api 로 호출합니다 (dev: vite 프록시, 운영: nginx).
# 보통은 비워 두는 게 맞습니다.
VITE_API_BASE_URL=

# vite dev 서버가 /api 요청을 넘길 백엔드 주소 (개발 전용)
VITE_DEV_API_TARGET=http://localhost:8000

# true 로 두면 백엔드 없이 mock 데이터로만 동작합니다 (디자인/퍼블리싱 작업용)
VITE_USE_MOCK=false

# 앱 이름 (선택)
VITE_APP_NAME=YuGuide AI

# 구글 캘린더 연동용 OAuth 클라이언트 ID (Google Cloud Console → 사용자 인증 정보)
# 클라이언트 시크릿은 필요 없음 — 토큰 플로우(GIS)라 프론트엔드에 그대로 노출돼도 안전함
VITE_GOOGLE_CLIENT_ID=
